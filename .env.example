# Copy this to .env for local dev. Never commit the real .env file.
DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Either set DATABASE_URL (used automatically on Railway/Fly), or the discrete
# DB_* vars below for local development.
DATABASE_URL=
DB_NAME=prayerapp_db
DB_USER=prayerapp
DB_PASSWORD=prayerapp_dev
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
